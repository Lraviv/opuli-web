# העתיקי קובץ זה ל-.env ומלאי ערכים אמיתיים (אל תעלי .env ל-git)

# מקומי (docker-compose): postgresql+psycopg://student:student@localhost:5432/student_app
# בענן (Neon וכו'): את מחרוזת החיבור שקיבלת מהספק, עם +psycopg אחרי postgresql
DATABASE_URL=postgresql+psycopg://student:student@localhost:5432/student_app

# מחרוזת אקראית וסודית לחתימת טוקנים - אפשר לייצר עם: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-random-secret

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# סוד לאימות הטריגר החיצוני שקורא ל-/internal/check-reminders (לא קשור למשתמשים)
# ייצור ערך: python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_SECRET=change-me-internal-secret

# משוב/באגים ממסך הפרופיל - מפתח API של Resend (https://resend.com/api-keys).
# ריק = טופס המשוב מחזיר 503. החשבון ב-Resend צריך להיות על lihirweb@gmail.com.
RESEND_API_KEY=
# Forum admins (comma-separated emails): can pin and hide community posts
ADMIN_EMAILS=
